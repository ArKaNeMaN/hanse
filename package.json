{
  "name": "hanse",
  "version": "0.1.0",
  "description": "Self-hosted coordinator/workbench for projects of isolated opencode agent applications.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hanse": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && npm run build:css",
    "build:css": "npx @tailwindcss/cli -i src/http/styles.css -o assets/app.css --minify",
    "design:showcase": "python3 -m http.server 4173",
    "design:capture": "node docs/design/capture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ssh2": "^1.17.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
