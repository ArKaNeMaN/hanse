  </aside>
      <div class="shell-main">
        <header class="topbar">
          <button class="btn btn-ghost btn-icon nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="sidebar" aria-label="Open navigation"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-menu" /></svg></button>
          <a class="topbar__brand" href="/">hanse</a>
          <nav class="breadcrumb" id="breadcrumb-host" aria-label="Breadcrumb" data-nav-id="handoffs"><a href="/">Workbench</a><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-right" /></svg><span aria-current="page">Handoffs</span></nav>
          <div class="topbar__actions"><a class="btn btn-ghost btn-icon" href="/ide/" target="_blank" rel="noreferrer" aria-label="Open IDE in a new tab" title="Open IDE"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a></div>
        </header>
        <main class="page" id="main" tabindex="-1">
          <header class="page-header">
    <div class="page-header__main">
      <p class="overline">Workbench</p>
      <h1 class="page-title">Handoffs</h1>
      <p class="page-description">Requests between sibling applications, with operator approval where required.</p>
      <div class="page-meta"><span class="mono">12 total</span><span class="mono">2 waiting</span><span class="mono">3 active</span><span class="mono">3 replies waiting</span></div>
    </div>
    
  </header>
          <div class="page__body"><div class="toolbar">
    <div class="segmented" role="group" aria-label="Handoff filter">
      <a class="segmented__item" href="/handoffs" aria-current="page">All <span class="mono">12</span></a>
      <a class="segmented__item" href="/handoffs?filter=waiting">Waiting <span class="mono">2</span></a>
      <a class="segmented__item" href="/handoffs?filter=active">Active <span class="mono">3</span></a>
      <a class="segmented__item" href="/handoffs?filter=closed">Closed <span class="mono">8</span></a>
      <a class="segmented__item" href="/handoffs?filter=replies">Replies <span class="mono">3</span></a>
    </div>
    <form class="cluster" method="get" action="/handoffs" role="search">
      
      <label class="sr-only" for="handoff-search">Search handoffs</label>
      <input class="input search-input" id="handoff-search" name="q" value="" placeholder="Id, summary, application" autocomplete="off" />
      <button class="btn btn-secondary" type="submit"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-search" /></svg>Search</button>
      
    </form>
  </div>
      <section class="card" aria-labelledby="handoffs-table-title">
        <div class="card__head"><h2 class="card__title" id="handoffs-table-title">All handoffs</h2><span class="mono">12</span></div>
        <div class="card__body card__body--flush">
          <div class="table-wrap">
            <table class="table table--stack table--handoffs table--inbox">
              <thead><tr><th scope="col">Id</th><th scope="col">Route</th><th scope="col">State</th><th scope="col">Summary</th><th scope="col">Updated</th><th scope="col"></th></tr></thead>
              <tbody><tr id="handoff-h-queued">
          <td data-label="Id"><span class="mono table__nowrap">h-queued</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="queued"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-clock" /></svg>Queued</span></div></td>
          <td data-label="Summary"><span class="table__primary">Summary h-queued</span></td>
          <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T11:50:00.000Z" title="2 Jan 2026, 11:50">10 min ago</time></span></td>
          <td data-label="Actions" class="table__actions"><div class="table__action-group"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-queued">Review</button></div></td>
        </tr><tr id="handoff-h-awaiting">
          <td data-label="Id"><span class="mono table__nowrap">h-awaiti</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="awaiting_approval"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Awaiting approval</span></div></td>
          <td data-label="Summary"><span class="table__primary">Summary h-awaiting</span></td>
          <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T11:40:00.000Z" title="2 Jan 2026, 11:40">20 min ago</time></span></td>
          <td data-label="Actions" class="table__actions"><div class="table__action-group"><form class="table__inline-form" method="post" action="/api/handoffs/h-awaiting/decision">
                <input type="hidden" name="approval_kind" value="dispatch" />
                <input type="hidden" name="return_to" value="/handoffs" />
                <button class="btn btn-danger btn-sm" type="submit" name="decision" value="rejected">Reject</button>
                <button class="btn btn-primary btn-sm" type="submit" name="decision" value="approved">Approve</button>
              </form><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-awaiting">Review</button></div></td>
        </tr><tr id="handoff-h-dispatching">
          <td data-label="Id"><span class="mono table__nowrap">h-dispat</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="dispatching"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-send" /></svg>Dispatching</span></div></td>
          <td data-label="Summary"><span class="table__primary">Summary h-dispatching</span></td>
          <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T11:30:00.000Z" title="2 Jan 2026, 11:30">30 min ago</time></span></td>
          <td data-label="Actions" class="table__actions"><div class="table__action-group"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-dispatching">Review</button></div></td>
        </tr><tr id="handoff-h-progress">
          <td data-label="Id"><span class="mono table__nowrap">h-progre</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="in_progress"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-activity" /></svg>In progress</span></div></td>
          <td data-label="Summary"><span class="table__primary">Summary h-progress</span></td>
          <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T11:20:00.000Z" title="2 Jan 2026, 11:20">40 min ago</time></span></td>
          <td data-label="Actions" class="table__actions"><div class="table__action-group"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-progress">Review</button></div></td>
        </tr><tr id="handoff-h-delivered">
          <td data-label="Id"><span class="mono table__nowrap">h-delive</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="delivered"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check" /></svg>Delivered</span></div></td>
          <td data-label="Summary"><span class="table__primary">Summary h-delivered</span></td>
          <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T11:10:00.000Z" title="2 Jan 2026, 11:10">50 min ago</time></span></td>
          <td data-label="Actions" class="table__actions"><div class="table__action-group"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-delivered">Review</button></div></td>
        </tr><tr id="handoff-h-rejected">
          <td data-label="Id"><span class="mono table__nowrap">h-reject</span></td>
          <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
          <td data-label="State"><div class="cluster"><span class="status" data-state="rejected"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x" /></svg>Rejected</span></div></td>
