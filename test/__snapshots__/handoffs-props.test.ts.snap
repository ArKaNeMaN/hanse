exports[`handoffs page props > keeps the legacy inbox HTML deriving from the same props 2`] = `
"<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Handoffs - hanse</title>
    <script>
      (function () {
        try {
          var saved = localStorage.getItem("hanse-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch (error) {}
      })();
    </script>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/app.js" defer></script>
    <script src="/assets/app-content.js" defer></script>
    
    <script type="module" src="/assets/handoff.js"></script>
  </head>
  <body class="app-body">
