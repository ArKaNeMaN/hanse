-4.414 4.414A2 2 0 0 0 7 17.828V22" /><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2" /></symbol><symbol id="i-alert-triangle" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><path d="M12 9v4M12 17h.01" /></symbol><symbol id="i-alert-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" /></symbol><symbol id="i-slash" viewBox="0 0 24 24"><path d="M22 2 2 22" /></symbol><symbol id="i-inbox" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></symbol><symbol id="i-copy" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></symbol><symbol id="i-terminal" viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5" /><line x1="12" x2="20" y1="19" y2="19" /></symbol><symbol id="i-code" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></symbol><symbol id="i-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></symbol><symbol id="i-refresh" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></symbol><symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" x2="10" y1="11" y2="17" /><line x1="14" x2="14" y1="11" y2="17" /></symbol><symbol id="i-lock" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></symbol><symbol id="i-log-out" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" x2="9" y1="12" y2="12" /></symbol><symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></symbol><symbol id="i-eye-off" viewBox="0 0 24 24"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></symbol><symbol id="i-loader" viewBox="0 0 24 24"><line x1="12" x2="12" y1="2" y2="6" /><line x1="12" x2="12" y1="18" y2="22" /><line x1="4.93" x2="7.76" y1="4.93" y2="7.76" /><line x1="16.24" x2="19.07" y1="16.24" y2="19.07" /><line x1="2" x2="6" y1="12" y2="12" /><line x1="18" x2="22" y1="12" y2="12" /><line x1="4.93" x2="7.76" y1="19.07" y2="16.24" /><line x1="16.24" x2="19.07" y1="7.76" y2="4.93" /></symbol><symbol id="i-more" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /><circle cx="5" cy="12" r="1" /></symbol></svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sr-only" id="route-announcer" aria-live="polite" aria-atomic="true"></div>
    <div class="app-shell" data-nav="closed" id="shell" data-nav-id="handoffs">
      <aside class="sidebar" id="sidebar" aria-label="Primary">
    <div class="sidebar__head">
      <a class="wordmark" href="/">hanse</a>
      <span class="sidebar__kicker">coordinator</span>
      <button class="btn btn-ghost btn-icon btn-sm sidebar__close" type="button" data-nav-close aria-label="Close navigation"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x" /></svg></button>
    </div>
    <nav class="sidebar__nav" id="sidebar-nav" aria-label="Workspace" data-nav-id="handoffs">
      <p class="nav-label">Workbench</p><a class="nav-item" href="/" data-nav-id="overview"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-dashboard" /></svg><span class="nav-item__label">Overview</span></a><a class="nav-item" href="/projects" data-nav-id="projects"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-folder" /></svg><span class="nav-item__label">Projects</span></a><a class="nav-item" href="/chat?app=master&amp;project=hanse-master" data-nav-id="master"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-gauge" /></svg><span class="nav-item__label">Master</span></a><a class="nav-item is-active" href="/handoffs" data-nav-id="handoffs" aria-current="page"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-branch" /></svg><span class="nav-item__label">Handoffs</span><span class="nav-item__mark"><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-check" /></svg></span><span class="nav-item__count">2</span></a><a class="nav-item" href="/skills" data-nav-id="skills"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-code" /></svg><span class="nav-item__label">Skills</span></a><a class="nav-item" href="/settings" data-nav-id="settings"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-settings" /></svg><span class="nav-item__label">Settings</span></a><a class="nav-item" href="/ssh" data-nav-id="ssh"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-terminal" /></svg><span class="nav-item__label">SSH</span></a><p class="nav-label">Projects</p><a class="nav-item" href="/projects/p" data-project-id="p"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-folder" /></svg><span class="nav-item__label">Demo</span><span class="nav-item__count">2</span></a><a class="nav-item" href="/projects" data-nav-id="projects"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-layers" /></svg><span class="nav-item__label">All projects</span></a>
    </nav>
    <div class="sidebar__foot">
      <span class="avatar avatar--sm">OP</span>
      <span class="sidebar__operator">operator</span>
      <button class="btn btn-ghost btn-sm theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme">
        <span class="theme-toggle__icon" data-theme-icon="light"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-sun" /></svg></span>
        <span class="theme-toggle__icon" data-theme-icon="dark"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-moon" /></svg></span>
        <span data-theme-label>Light</span>
      </button>
      <form method="post" action="/logout">
        <button class="btn btn-ghost btn-icon btn-sm" type="submit" aria-label="Sign out" title="Sign out"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-log-out" /></svg></button>
      </form>
