          <div class="topbar__actions"><a class="btn btn-ghost btn-icon" href="/ide/" target="_blank" rel="noreferrer" aria-label="Open IDE in a new tab" title="Open IDE"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a></div>
        </header>
        <main class="page" id="main" tabindex="-1">
          <header class="page-header">
    <div class="page-header__main">
      <p class="overline">Workbench</p>
      <h1 class="page-title">Fleet overview</h1>
      <p class="page-description">Current state of every project, application, and handoff in this workspace.</p>
      <div class="page-meta"><span class="mono">1 project</span><span class="mono">2 applications</span></div>
    </div>
    <div class="page-header__actions"><button class="btn btn-primary" type="button" data-dialog-open="new-project"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus" /></svg>New project</button></div>
  </header>
          <div class="page__body"><div class="watch-strip watch-strip--4">
    <div class="watch"><p class="watch__value">1</p><p class="watch__label">Projects</p></div>
    <div class="watch"><p class="watch__value">2</p><p class="watch__label">Applications</p></div>
    <div class="watch"><p class="watch__value">1</p><p class="watch__label">Agents running</p></div>
    <div class="watch"><p class="watch__value">2</p><p class="watch__label">Handoffs waiting</p></div>
  </div>
        <div class="workbench-grid section">
          <div class="stack">
            <section class="card" aria-labelledby="project-ledger-title">
          <div class="card__head">
            <h2 class="card__title" id="project-ledger-title">Project ledger</h2>
            <a class="btn btn-ghost btn-sm" href="/projects">All projects <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg></a>
          </div>
          <div class="card__body card__body--flush">
            <div class="table-wrap">
              <table class="table table--stack">
                <thead><tr><th scope="col">Project</th><th scope="col">Root path</th><th scope="col">Apps</th><th scope="col">Waiting</th><th scope="col">Last activity</th><th scope="col"></th></tr></thead>
                <tbody><tr>
        <td data-label="Project"><div class="cluster"><a class="table__primary" href="/projects/p">Demo</a></div></td>
        <td data-label="Root path"><span class="mono">/workspace/demo</span></td>
        <td data-label="Apps" class="table__num">2</td>
        <td data-label="Waiting" class="table__num">2</td>
        <td data-label="Last activity"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span></td>
        <td data-label="Actions" class="table__actions"><a class="btn btn-ghost btn-icon btn-sm" href="/projects/p" aria-label="Open Demo"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-right" /></svg></a></td>
      </tr></tbody>
              </table>
            </div>
          </div>
        </section>
            <section class="card" aria-labelledby="recent-handoffs-title">
              <div class="card__head">
                <h2 class="card__title" id="recent-handoffs-title">Recent handoffs</h2>
                <a class="btn btn-ghost btn-sm" href="/handoffs">Handoffs inbox <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg></a>
              </div>
              <div class="card__body card__body--flush"><div class="table-wrap">
          <table class="table table--stack table--handoffs">
            <thead><tr><th scope="col">Route</th><th scope="col">Summary</th><th scope="col">State</th><th scope="col">Time</th><th scope="col"></th></tr></thead>
            <tbody><tr>
                  <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
                  <td data-label="Summary"><span class="table__primary">Ship the change</span></td>
                  <td data-label="State"><div class="cluster"><span class="status" data-state="delivered"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check" /></svg>Delivered</span><span class="badge"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Reply approval</span></div></td>
                  <td data-label="Time"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span></td>
                  <td data-label="Actions" class="table__actions"><a class="btn btn-ghost btn-sm" href="/handoffs?q=h-done">Review</a></td>
                </tr><tr>
                  <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
                  <td data-label="Summary"><span class="table__primary">Wait for review</span></td>
                  <td data-label="State"><div class="cluster"><span class="status" data-state="awaiting_approval"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Awaiting approval</span></div></td>
                  <td data-label="Time"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span></td>
                  <td data-label="Actions" class="table__actions"><a class="btn btn-ghost btn-sm" href="/handoffs?q=h-wait">Review</a></td>
                </tr></tbody>
          </table>
        </div></div>
            </section>
