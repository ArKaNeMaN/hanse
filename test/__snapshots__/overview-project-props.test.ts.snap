      <p class="mono">1</p>
      <p class="mono">created 2 Jan 2026, 12:00</p>
      <p class="mono">updated 2 Jan 2026, 12:00</p>
    </div>
    
    <div class="stack--tight">
          <p class="overline">Result (completed)</p>
          <div class="prose handoff-md" data-markdown>Done.</div>
        </div>
    <div class="stack--tight">
          <p class="overline">Reply</p>
          <div class="cluster"><span class="badge"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Reply approval</span></div>
          
          
          
        </div>
