        <span class="route__app">b</span>
        <span class="route__meta">target</span>
      </span>
    </div>
    <p class="route-card__summary">Ship the change</p>
    
  </article>
    <div class="stack--tight">
      <p class="overline">Policy</p>
      <p class="small">Dispatch: <span class="mono">auto</span> · Reply: <span class="mono">auto</span> · Origin: <span class="mono">agent</span></p>
    </div>
    <div class="stack--tight">
      <p class="overline">Sessions</p>
      <p class="small">Source: <span class="small">Not bound to a session yet</span></p>
