  </article></div></div>
            </section>
            <section class="card" aria-labelledby="runtime-title">
              <div class="card__head"><h2 class="card__title" id="runtime-title">Runtime</h2><span class="mono">2 apps</span></div>
              <div class="card__body stack--tight">
                <div class="summary-row"><span class="small">Starting</span><span class="cluster"><span class="status" data-state="dispatching"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-loader" /></svg>Starting</span><span class="mono">0</span></span></div>
                <div class="summary-row"><span class="small">Running</span><span class="cluster"><span class="status" data-state="in_progress"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-activity" /></svg>Running</span><span class="mono">1</span></span></div>
                <div class="summary-row"><span class="small">Stopped</span><span class="cluster"><span class="status" data-state="queued"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-clock" /></svg>Stopped</span><span class="mono">1</span></span></div>
                <div class="summary-row"><span class="small">Error</span><span class="cluster"><span class="status" data-state="failed"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-alert-triangle" /></svg>Error</span><span class="mono">0</span></span></div>
              </div>
              <div class="card__foot"><a class="btn btn-ghost btn-sm" href="/projects">Inspect applications <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg></a></div>
            </section>
          </aside>
        </div>
        <dialog class="dialog" id="new-project" aria-labelledby="new-project-title">
    <div class="dialog__frame">
      <header class="dialog__head">
        <h2 class="dialog__title" id="new-project-title">New project</h2>
        <p class="dialog__meta">Creates a project manifest in the workspace</p>
      </header>
      <form class="dialog__form" method="post" action="/api/projects">
        <div class="dialog__body">
          <div class="field">
            <label class="label" for="new-project-name">Project name (required)</label>
            <input class="input" id="new-project-name" name="name" required autocomplete="off" placeholder="northbank" aria-describedby="new-project-hint" />
            <p class="hint" id="new-project-hint">A slugged folder with .hanse/project.yaml is created under the workspace root.</p>
          </div>
        </div>
        <footer class="dialog__foot">
          <button class="btn btn-ghost" type="button" data-dialog-close>Cancel</button>
          <button class="btn btn-primary" type="submit">Create project</button>
        </footer>
      </form>
    </div>
  </dialog></div>
        </main>
      </div>
      <div class="scrim" data-nav-close></div>
    </div>
    <div class="toast-region" id="toast-region" aria-live="polite" aria-atomic="false"></div>
    
  </body>
</html>"
`;

exports[`project page props > keeps the legacy project HTML deriving from the same props 1`] = `
"<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Demo - hanse</title>
    <script>
      (function () {
        try {
          var saved = localStorage.getItem("hanse-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch (error) {}
      })();
    </script>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/app.js" defer></script>
    <script src="/assets/app-content.js" defer></script>
    
    <script type="module" src="/assets/handoff.js"></script>
  </head>
