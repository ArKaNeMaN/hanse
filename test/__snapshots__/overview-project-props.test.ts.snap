exports[`overview page props > keeps the legacy overview HTML deriving from the same props 1`] = `
"<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
