    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sr-only" id="route-announcer" aria-live="polite" aria-atomic="true"></div>
    <div class="app-shell" data-nav="closed" id="shell" data-nav-id="project" data-project-id="p">
      <aside class="sidebar" id="sidebar" aria-label="Primary">
    <div class="sidebar__head">
      <a class="wordmark" href="/">hanse</a>
      <span class="sidebar__kicker">coordinator</span>
      <button class="btn btn-ghost btn-icon btn-sm sidebar__close" type="button" data-nav-close aria-label="Close navigation"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x" /></svg></button>
    </div>
    <nav class="sidebar__nav" id="sidebar-nav" aria-label="Workspace" data-nav-id="project" data-project-id="p">
      <p class="nav-label">Workbench</p><a class="nav-item" href="/" data-nav-id="overview"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-dashboard" /></svg><span class="nav-item__label">Overview</span></a><a class="nav-item" href="/projects" data-nav-id="projects"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-folder" /></svg><span class="nav-item__label">Projects</span></a><a class="nav-item" href="/chat?app=master&amp;project=hanse-master" data-nav-id="master"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-gauge" /></svg><span class="nav-item__label">Master</span></a><a class="nav-item" href="/handoffs" data-nav-id="handoffs"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-branch" /></svg><span class="nav-item__label">Handoffs</span><span class="nav-item__count">2</span></a><a class="nav-item" href="/projects/p/skills" data-nav-id="skills"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-code" /></svg><span class="nav-item__label">Skills</span></a><a class="nav-item" href="/projects/p/settings" data-nav-id="settings"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-settings" /></svg><span class="nav-item__label">Settings</span></a><a class="nav-item" href="/ssh" data-nav-id="ssh"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-terminal" /></svg><span class="nav-item__label">SSH</span></a><p class="nav-label">Projects</p><a class="nav-item is-active" href="/projects/p" data-project-id="p" aria-current="page"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-folder" /></svg><span class="nav-item__label">Demo</span><span class="nav-item__mark"><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-check" /></svg></span><span class="nav-item__count">2</span></a><a class="nav-item" href="/projects" data-nav-id="projects"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-layers" /></svg><span class="nav-item__label">All projects</span></a>
    </nav>
    <div class="sidebar__foot">
      <span class="avatar avatar--sm">OP</span>
      <span class="sidebar__operator">operator</span>
      <button class="btn btn-ghost btn-sm theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme">
        <span class="theme-toggle__icon" data-theme-icon="light"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-sun" /></svg></span>
        <span class="theme-toggle__icon" data-theme-icon="dark"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-moon" /></svg></span>
        <span data-theme-label>Light</span>
      </button>
      <form method="post" action="/logout">
        <button class="btn btn-ghost btn-icon btn-sm" type="submit" aria-label="Sign out" title="Sign out"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-log-out" /></svg></button>
      </form>
    </div>
  </aside>
      <div class="shell-main">
        <header class="topbar">
          <button class="btn btn-ghost btn-icon nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="sidebar" aria-label="Open navigation"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-menu" /></svg></button>
          <a class="topbar__brand" href="/">hanse</a>
          <nav class="breadcrumb" id="breadcrumb-host" aria-label="Breadcrumb" data-nav-id="project"><a href="/projects">Projects</a><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-right" /></svg><span aria-current="page">Demo</span></nav>
          <div class="topbar__actions"><a class="btn btn-ghost btn-icon" href="/ide/" target="_blank" rel="noreferrer" aria-label="Open IDE in a new tab" title="Open IDE"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a></div>
        </header>
        <main class="page" id="main" tabindex="-1">
          <header class="page-header">
    <div class="page-header__main">
      <p class="overline">Project</p>
      <h1 class="page-title">Demo</h1>
      <p class="page-description">Applications, handoff routes, and runtime state for this project.</p>
      <div class="page-meta"><span class="mono">/workspace/demo</span><span class="mono">base main</span><span class="mono">2 applications</span><span class="mono">2 waiting</span></div>
    </div>
    <div class="page-header__actions"><a class="btn btn-secondary" href="/projects/p/settings"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-settings" /></svg>Settings</a><a class="btn btn-secondary" href="/ide/?folder=%2Fworkspace%2Fdemo" target="_blank" rel="noreferrer"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg>Open IDE</a><button class="btn btn-primary" type="button" data-dialog-open="new-handoff"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-branch" /></svg>New handoff</button></div>
  </header>
          <div class="page__body"><div class="watch-strip watch-strip--4">
      <div class="watch"><p class="watch__value">2</p><p class="watch__label">Applications</p></div>
      <div class="watch"><p class="watch__value">1</p><p class="watch__label">Running</p></div>
      <div class="watch"><p class="watch__value">2</p><p class="watch__label">Waiting</p></div>
      <div class="watch"><p class="watch__value">just now</p><p class="watch__label">Last activity</p></div>
    </div>
    <div class="workbench-grid workbench-grid--detail section">
      <div class="stack">
        <section class="card" aria-labelledby="apps-title">
          <div class="card__head">
            <h2 class="card__title" id="apps-title">Applications</h2>
            <div class="cluster"><span class="badge">2 apps</span><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="add-app"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus" /></svg>Add app</button></div>
          </div>
          <div class="card__body card__body--flush"><div class="table-wrap">
          <table class="table table--stack">
            <thead><tr><th scope="col">Application</th><th scope="col">Kind</th><th scope="col">Path</th><th scope="col">Runtime</th><th scope="col"></th></tr></thead>
            <tbody><tr>
        <td data-label="Application"><div class="cluster"><strong class="table__primary"><a href="/projects/p/apps/a">a</a></strong></div></td>
        <td data-label="Kind"><span class="badge badge--mono">app</span></td>
        <td data-label="Path"><span class="mono">apps/a</span></td>
        <td data-label="Runtime"><div class="cluster"><span class="status" data-state="in_progress"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-activity" /></svg>Running</span></div></td>
        <td data-label="Actions" class="table__actions"><div class="table__action-group">
          <a class="btn btn-ghost btn-sm" href="/chat?app=a&amp;project=p"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-message" /></svg>Chat</a>
          <a class="btn btn-ghost btn-icon btn-sm" href="/ide/?folder=%2Fworkspace%2Fdemo%2Fapps%2Fa" target="_blank" rel="noreferrer" aria-label="Open a in IDE" title="Open in IDE"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a>
          <a class="btn btn-ghost btn-icon btn-sm" href="/projects/p/apps/a" aria-label="Open a application" title="Open application"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-right" /></svg></a>
        </div></td>
      </tr><tr>
        <td data-label="Application"><div class="cluster"><strong class="table__primary"><a href="/projects/p/apps/b">b</a></strong></div></td>
        <td data-label="Kind"><span class="badge badge--mono">app</span></td>
        <td data-label="Path"><span class="mono">apps/b</span></td>
        <td data-label="Runtime"><div class="cluster"><span class="status" data-state="queued"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-clock" /></svg>Stopped</span></div></td>
        <td data-label="Actions" class="table__actions"><div class="table__action-group">
          <a class="btn btn-ghost btn-sm" href="/chat?app=b&amp;project=p"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-message" /></svg>Chat</a>
          <a class="btn btn-ghost btn-icon btn-sm" href="/ide/?folder=%2Fworkspace%2Fdemo%2Fapps%2Fb" target="_blank" rel="noreferrer" aria-label="Open b in IDE" title="Open in IDE"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a>
          <a class="btn btn-ghost btn-icon btn-sm" href="/projects/p/apps/b" aria-label="Open b application" title="Open application"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-right" /></svg></a>
        </div></td>
      </tr></tbody>
          </table>
        </div></div>
        </section>
        <section class="card" aria-labelledby="project-handoffs-title">
          <div class="card__head"><h2 class="card__title" id="project-handoffs-title">Handoffs</h2><span class="mono">2</span></div>
          <div class="card__body card__body--flush"><div class="table-wrap">
          <table class="table table--stack table--handoffs">
            <thead><tr><th scope="col">Route</th><th scope="col">State</th><th scope="col">Summary</th><th scope="col">Updated</th><th scope="col"></th></tr></thead>
            <tbody><tr id="handoff-h-done">
        <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
        <td data-label="State"><div class="cluster"><span class="status" data-state="delivered"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check" /></svg>Delivered</span><span class="badge"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Reply approval</span></div></td>
        <td data-label="Summary"><span class="table__primary">Ship the change</span></td>
        <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span></td>
        <td data-label="Actions" class="table__actions"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-done">Review</button></td>
      </tr><tr id="handoff-h-wait">
        <td data-label="Route"><span class="table__route"><span class="mono">a</span><svg class="icon icon--sm" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg><span class="mono">b</span></span></td>
        <td data-label="State"><div class="cluster"><span class="status" data-state="awaiting_approval"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Awaiting approval</span></div></td>
        <td data-label="Summary"><span class="table__primary">Wait for review</span></td>
        <td data-label="Updated"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span></td>
        <td data-label="Actions" class="table__actions"><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-wait">Review</button></td>
      </tr></tbody>
          </table>
        </div></div>
        </section>
        <section class="card" aria-labelledby="handoff-policy-title">
    <div class="card__head"><h2 class="card__title" id="handoff-policy-title">Handoff policy</h2><span class="badge">1 rules</span></div>
    <div class="card__body stack--tight">
      <p class="small">The most specific rule wins: exact pair, then one wildcard (a from-specific rule wins a tie), then the project default. No matching rule means <span class="mono">auto</span> dispatch and <span class="mono">auto</span> reply.</p>
      <div class="table-wrap"><table class="table table--stack">
          <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Dispatch</th><th scope="col">Reply</th><th scope="col"></th></tr></thead>
          <tbody><tr>
                <td data-label="From"><span class="mono">a</span></td>
                <td data-label="To"><span class="mono">b</span></td>
                <td data-label="Dispatch"><span class="mono">approve</span></td>
                <td data-label="Reply"><span class="mono">approve</span></td>
                <td data-label="" class="table__actions"><form method="post" action="/api/projects/p/handoff-policy/delete">
                  <input type="hidden" name="from" value="a" />
                  <input type="hidden" name="to" value="b" />
                  <input type="hidden" name="return_to" value="/projects/p" />
                  <button class="btn btn-ghost btn-sm" type="submit">Delete</button>
                </form></td>
              </tr></tbody>
        </table></div>
      <form class="stack--tight" method="post" action="/api/projects/p/handoff-policy">
        <div class="cluster">
          <div class="field"><label class="label" for="handoff-policy-from">From</label><div class="select-wrap"><select class="select" id="handoff-policy-from" name="from"><option value="*">Any application</option><option value="a">a</option><option value="b">b</option></select><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-down" /></svg></div></div>
          <div class="field"><label class="label" for="handoff-policy-to">To</label><div class="select-wrap"><select class="select" id="handoff-policy-to" name="to"><option value="*">Any application</option><option value="a">a</option><option value="b">b</option></select><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-down" /></svg></div></div>
          <div class="field"><label class="label" for="handoff-policy-dispatch">Dispatch</label><div class="select-wrap"><select class="select" id="handoff-policy-dispatch" name="dispatch_mode"><option value="auto">Auto</option><option value="approve">Approve</option><option value="deny">Deny</option></select><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-down" /></svg></div></div>
          <div class="field"><label class="label" for="handoff-policy-reply">Reply</label><div class="select-wrap"><select class="select" id="handoff-policy-reply" name="reply_mode"><option value="auto">Auto</option><option value="approve">Approve</option></select><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-down" /></svg></div></div>
        </div>
        <input type="hidden" name="return_to" value="/projects/p" />
        <div class="cluster"><button class="btn btn-secondary btn-sm" type="submit">Save rule</button></div>
      </form>
    </div>
  </section>
      </div>
      <aside class="rail-stack" aria-label="Project attention">
        <section class="card" aria-labelledby="project-waiting-title">
          <div class="card__head"><h2 class="card__title" id="project-waiting-title">Waiting for approval</h2><span class="mono">2</span></div>
          <div class="card__body"><div class="stack"><article class="route-card" data-state="awaiting_approval">
    <div class="route-card__head">
      <span class="mono table__nowrap">h-done</span>
      <span class="status" data-state="awaiting_approval"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg>Awaiting approval</span>
    </div>
    <div class="route" aria-label="Handoff from a to b">
      <span class="route__end">
        <span class="route__app">a</span>
        <span class="route__meta">origin</span>
      </span>
      <span class="route__track" aria-hidden="true">
        <span class="route__node"></span>
        <span class="route__seal"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-stamp" /></svg></span>
        <span class="route__node"></span>
      </span>
      <span class="route__end route__end--to">
        <span class="route__app">b</span>
        <span class="route__meta">target</span>
      </span>
    </div>
    <p class="route-card__summary">Ship the change</p>
    <div class="route-card__foot"><span class="mono table__nowrap"><time datetime="2026-01-02T12:00:00.000Z" title="2 Jan 2026, 12:00">just now</time></span><button class="btn btn-ghost btn-sm" type="button" data-dialog-open="h-h-done">Review <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-right" /></svg></button></div>
  </article><article class="route-card" data-state="awaiting_approval">
    <div class="route-card__head">
