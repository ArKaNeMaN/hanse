# Copy to .env and change the token. Never commit the real file.
#
# Required: the single operator login for the web UI and the IDE. Use a long random value, e.g.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HANSE_OPERATOR_TOKEN=change-me

# Required: shared secret between the coordinator and the internal agents supervisor. It is not
# exposed publicly; generate a second long random value and keep it out of logs.
HANSE_RUNTIME_TOKEN=change-me-runtime

# Optional: image repositories and tags (defaults shown). Except for HANSE_AGENT_BASE_IMAGE below,
# image variables are repositories only, not full references or digests; Compose always appends
# ":${tag}". `latest` tracks main; pin a `sha-<short>`, `sha-<full>`, or release tag for a
# reproducible deployment. HANSE_TAG is the coordinator tag; the per-app agent defaults to it, and
# the IDE and runner fall back to HANSE_AGENT_TAG and then HANSE_TAG unless their own tag is set.
# HANSE_IMAGE=ghcr.io/arkaneman/hanse
# HANSE_TAG=latest
# HANSE_AGENT_IMAGE=ghcr.io/arkaneman/hanse-agent-default
# HANSE_AGENT_TAG=latest
# HANSE_IDE_IMAGE=ghcr.io/arkaneman/hanse-agent-ide
# HANSE_IDE_TAG=latest
# HANSE_RUNNER_IMAGE=ghcr.io/arkaneman/hanse-runner
# HANSE_RUNNER_TAG=latest

# Optional: shared base image for per-app images that declare `build.base: base`. Unlike the
# repository variables above, this is a complete reference: repository plus an optional `:tag` or
# `@sha256:<digest>`; Compose does not append a tag. The default is the published `hanse-agent-base`
# image at HANSE_AGENT_TAG, then HANSE_TAG. `build.base: base` requires this reference; without a
# value that configuration is rejected instead of silently falling back. Deployment must pull the
# resolved default and base images before recreating services; an image that was not pulled is
# `unknown` (never current) until it is present.
# HANSE_AGENT_BASE_IMAGE=ghcr.io/arkaneman/hanse-agent-base:latest

# Optional: idle agent maintenance (defaults shown). Auto-stop and auto-update compare against the
# durable per-app activity clock; set a value to 0 to disable that action. Auto-update only restarts
# onto an already present, pinned image when the launch fingerprint is unchanged, so pending settings
# never apply silently. HANSE_AGENT_MAINTENANCE_INTERVAL_MS is clamped to at least 30 seconds.
# HANSE_AGENT_AUTO_STOP_MS=172800000
# HANSE_AGENT_AUTO_UPDATE_MS=10800000
# HANSE_AGENT_MAINTENANCE_INTERVAL_MS=300000

# Optional: default/base image auto-pull interval (default 15 minutes); 0 disables auto-pull. A
# digest-pinned reference does not move, so auto-pull is a no-op there; pin digests or set 0 for a
# reproducible deployment. Mutable tags can introduce an unreviewed image and there is no signature
# verification in this iteration.
# HANSE_AGENT_AUTO_PULL_MS=900000

# Optional: absolute host path of the Docker data root (default shown). Compose bind-mounts it into
# the runner read-only at the same path and the pull disk guard statfs'es it. When it is unset or its
# filesystem usage cannot be read, the guard reports no disk data and pulls fail closed.
# HANSE_DOCKER_DATA_ROOT=/var/lib/docker

# Optional: maximum bytes for one pulled image. An image above the budget (or one whose size cannot
# be determined) is removed and the pull fails closed; leave unset for no explicit budget.
# HANSE_PULL_MAX_BYTES=

# HANSE_REVISION is image-provided, not an operator setting: it is the full commit revision baked
# into the image at build time and reported by GET /readyz as "revision" ("unknown" for a source
# build without REVISION). Do not set it in .env.

# Optional: listen address and port. The default binds loopback only. Set HANSE_BIND=0.0.0.0 to
# expose it on the LAN; put a firewall or an authenticated reverse proxy in front of it.
# HANSE_BIND=127.0.0.1
# HANSE_PORT=8787

# HANSE_UI_DEV_URL=http://127.0.0.1:5173 is development-only: run `npm run dev:ui` and leave it unset
# in production images.

# Optional: host paths for projects/applications, coordinator state, and per-app agent state
# (defaults shown). `agents` holds per-app HOME/XDG/MISE state and MCP tokens; back it up too.
# Attachment files and managed git credentials live under HANSE_HOST_MOUNTS, not `agents`.
# HANSE_WORKSPACE=./workspace
# HANSE_STATE=./state
# HANSE_AGENTS=./agents

# Optional: absolute path to the external deployment lock read by the coordinator (default shown).
# The file is written and removed by the external orchestrator; the coordinator only reads it.
# HANSE_DEPLOY_LOCK_FILE=/data/state/hanse/deploy.lock

# Optional: graceful shutdown budget in milliseconds (default 25000, clamped to 1000..28000).
# Keep it below the Compose stop_grace_period (30s). HANSE_START_DRAINED=1 starts the coordinator
# already rejecting mutations; otherwise a restarted coordinator resumes on startup.
# HANSE_SHUTDOWN_GRACE_MS=25000
# HANSE_START_DRAINED=0

# B1 only: absolute host paths used to mount individual app directories into per-app containers.
# Required when the runner service is enabled. HANSE_HOST_MOUNTS is the coordinator-owned root for
# attachment and managed git-credential bind sources. It must not overlap the workspace or agents
# roots; the coordinator mounts it read-write and the runner mounts it read-only. Create it next to
# the other volumes and make it writable by uid 1000 (for example `mounts` in this directory).
# HANSE_HOST_WORKSPACE=/absolute/path/to/workspace
# HANSE_HOST_AGENTS=/absolute/path/to/agents
# HANSE_HOST_MOUNTS=/absolute/path/to/mounts
# HANSE_RUNNER_BUILD_IMAGE=hanse-runner:dev

# Optional: runner temp root for one-shot Test-connection credential dirs (default shown). It must be
# an absolute writable host path that does not overlap HANSE_HOST_WORKSPACE or HANSE_HOST_AGENTS, and
# it is mounted into the runner at the same absolute path. Do not place it on a shared/backed-up
# volume; draft credentials are removed after each test.
# HANSE_HOST_RUNNER_TMP=/var/lib/hanse/tmp

# Optional: durable host path for bounded image build records (default shown). It is mounted into the
# runner at the same absolute path and kept across restarts. Do not use the ephemeral
# HANSE_HOST_RUNNER_TMP for build records; records are written atomically with mode 0600.
# HANSE_BUILD_RECORDS_DIR=/var/lib/hanse/builds

# Optional: runner-enforced maxima for application resources. Requests above a configured maximum
# are rejected with `400 resource_limit` instead of being clamped; an unset maximum means no limit.
# HANSE_APP_MEMORY_MAX_MB=4096
# HANSE_APP_CPUS_MAX=4
# HANSE_APP_PIDS_MAX=2048

# Git credentials and commit identity are configured per scope in the web UI under
# Settings -> Git (global, project, or application). SSH and HTTPS credentials are encrypted at rest
# and materialized into each application's HOME; they are no longer read from the environment. The
# legacy HANSE_HOST_GIT_DIR and HANSE_GIT_* credential/config variables were removed with no
# fallback. Local status/switch/commit work without credentials; fetch/update/push fail clearly when
# no credential is configured. The app image needs git and openssh-client for SSH.

# Optional: use compose.host-auth.yaml with a host opencode auth.json.
# HANSE_HOST_AUTH_FILE=/home/you/.local/share/opencode/auth.json
