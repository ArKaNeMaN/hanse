# Copy to .env and change the token. Never commit the real file.
#
# Required: the single operator login for the web UI and the IDE. Use a long random value, e.g.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HANSE_OPERATOR_TOKEN=change-me

# Required: shared secret between the coordinator and the internal agents supervisor. It is not
# exposed publicly; generate a second long random value and keep it out of logs.
HANSE_RUNTIME_TOKEN=change-me-runtime

# Optional: image repository and tag (defaults shown). `latest` tracks main; pin a `sha-<short>` or
# release tag for a reproducible deployment. Agent and IDE images default to the same tag as
# HANSE_TAG unless HANSE_AGENT_TAG is set.
# HANSE_IMAGE=ghcr.io/arkaneman/hanse
# HANSE_TAG=latest
# HANSE_AGENT_IMAGE=ghcr.io/arkaneman/hanse-agent-default
# HANSE_IDE_IMAGE=ghcr.io/arkaneman/hanse-agent-ide
# HANSE_RUNNER_IMAGE=ghcr.io/arkaneman/hanse-runner
# HANSE_AGENT_TAG=latest

# Optional: listen address and port. The default binds loopback only. Set HANSE_BIND=0.0.0.0 to
# expose it on the LAN; put a firewall or an authenticated reverse proxy in front of it.
# HANSE_BIND=127.0.0.1
# HANSE_PORT=8787

# Optional: host paths for projects/applications, coordinator state, and per-app agent state
# (defaults shown). `agents` holds per-app HOME/XDG/MISE state and MCP tokens; back it up too.
# HANSE_WORKSPACE=./workspace
# HANSE_STATE=./state
# HANSE_AGENTS=./agents

# B1 only: absolute host paths used to mount individual app directories into per-app containers.
# Required when the runner service is enabled.
# HANSE_HOST_WORKSPACE=/absolute/path/to/workspace
# HANSE_HOST_AGENTS=/absolute/path/to/agents
# HANSE_RUNNER_BUILD_IMAGE=hanse-runner:dev

# Optional: runner temp root for one-shot Test-connection credential dirs (default shown). It must be
# an absolute writable host path that does not overlap HANSE_HOST_WORKSPACE or HANSE_HOST_AGENTS, and
# it is mounted into the runner at the same absolute path. Do not place it on a shared/backed-up
# volume; draft credentials are removed after each test.
# HANSE_HOST_RUNNER_TMP=/var/lib/hanse/tmp

# Git credentials and commit identity are configured per scope in the web UI under
# Settings -> Git (global, project, or application). SSH and HTTPS credentials are encrypted at rest
# and materialized into each application's HOME; they are no longer read from the environment. The
# legacy HANSE_HOST_GIT_DIR and HANSE_GIT_* credential/config variables were removed with no
# fallback. Local status/switch/commit work without credentials; fetch/update/push fail clearly when
# no credential is configured. The app image needs git and openssh-client for SSH.

# Optional: use compose.host-auth.yaml with a host opencode auth.json.
# HANSE_HOST_AUTH_FILE=/home/you/.local/share/opencode/auth.json
